# OpenRouter — required
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase — required for auth + billing
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never expose to browser

# Stripe — required for billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_10=price_...          # $0.99  → 10 credits
STRIPE_PRICE_50=price_...          # $3.99  → 50 credits
STRIPE_PRICE_200=price_...         # $12.99 → 200 credits

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
